APP_NAME=RTK IT School CRM API
APP_VERSION=3.1.0
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crm
CORS_ORIGINS=http://localhost:3000

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=rtk
KEYCLOAK_CLIENT_ID=rtk-crm
# Set when the Keycloak client is confidential; leave empty for a public client.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_AUDIENCE=
KEYCLOAK_VERIFY_AUDIENCE=false
KEYCLOAK_ROLE_CLAIM=realm_access
KEYCLOAK_ROLES_CLAIM=roles
KEYCLOAK_DEFAULT_ROLE=user
AUTH_REQUIRED=true
AUTH_AUTO_PROVISION=true

# Keycloak service account used only by /auth/register.
# Create a confidential client with Service Accounts enabled and grant realm-management -> manage-users.
KEYCLOAK_ADMIN_CLIENT_ID=rtk-crm-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=52428800
