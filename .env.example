APP_NAME=RTK IT School CRM API
APP_VERSION=4.0.0
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crm
CORS_ORIGINS=http://localhost:3000

# Local authentication. No external identity provider is required.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
DEFAULT_ROLE=user
AUTH_REQUIRED=true
INVITATION_EXPIRE_HOURS=48
FRONTEND_BASE_URL=http://localhost:3000

STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=52428800
PASSWORD_RESET_EXPIRE_HOURS=2
EMAIL_VERIFICATION_EXPIRE_HOURS=24
DEBUG_RETURN_AUTH_TOKENS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true


# Logging
LOG_LEVEL=INFO
LOG_DIR=./storage/logs

# Local test UI/runner. Disable on public production deployments.
TEST_UI_ENABLED=true
